# Perfil local; staging/production exigen clave aleatoria y configuración explícita.
APP_ENV=local
# PostgreSQL de Compose. Usa las mismas credenciales en DATABASE_URL.
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=soundpass
DATABASE_URL=postgresql+psycopg2://your_db_user:your_db_password@db:5432/soundpass

# JWT auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# URL privada de Ollama accesible desde el backend. Vacía desactiva el asistente.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=55

# Integraciones opcionales.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TICKETMASTER_API_KEY=

# Catálogo de Ticketmaster.
TICKETMASTER_COUNTRY_CODE=CO
TICKETMASTER_WINDOW_DAYS=365
TICKETMASTER_SYNC_INTERVAL_SECONDS=1800

# Optional worldwide catalog scoped to verified singer origin (runtime choice).
TICKETMASTER_SCOPE=country
TICKETMASTER_ARTIST_ORIGINS=US,MX,CO,AR,PR
TICKETMASTER_ARTISTS_PER_ORIGIN=15
TICKETMASTER_ARTIST_MIN_SITELINKS=20
