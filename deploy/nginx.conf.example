# Plantilla para nginx EN EL HOST. Sustituir host y rutas de certificado.
server {
    listen 80;
    listen [::]:80;
    server_name soundpass.example.invalid;
    return 301 https://soundpass.example.invalid$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name soundpass.example.invalid;
    ssl_certificate /etc/letsencrypt/live/soundpass.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/soundpass.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /var/www/soundpass;

    # Impide fallback HTML para documentación, incluso con configuración local accidental.
    location ~ ^/(api/)?(docs|redoc|openapi\.json)(/|$) { return 404; }
    location = /api { return 308 /api/; }
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location = / { try_files /index.html =404; }
    location = /index.html { try_files $uri =404; }
    location = /style.css { try_files $uri =404; }
    location = /script.js { try_files $uri =404; }
    location / { return 404; }
}
