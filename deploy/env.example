# Copiar a backend/.env privado en la VM y reemplazar los valores de ejemplo.
APP_ENV=production
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=replace_with_random_database_password
POSTGRES_DB=soundpass
# Codificar caracteres reservados del usuario/password en esta URL.
DATABASE_URL=postgresql+psycopg2://your_db_user:replace_with_random_database_password@db:5432/soundpass
SECRET_KEY=replace_with_generated_random_key
# Vacío para acceso exclusivo desde el mismo origen.
ALLOWED_ORIGINS=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TICKETMASTER_API_KEY=

# URL privada de Ollama accesible desde el backend. Vacía desactiva el asistente.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=55

# Discovery music catalog: private key remains backend-only.
TICKETMASTER_COUNTRY_CODE=CO
TICKETMASTER_WINDOW_DAYS=365
TICKETMASTER_SYNC_INTERVAL_SECONDS=1800

# Optional worldwide catalog scoped to verified singer origin (runtime choice).
TICKETMASTER_SCOPE=country
TICKETMASTER_ARTIST_ORIGINS=US,MX,CO,AR,PR
TICKETMASTER_ARTISTS_PER_ORIGIN=15
TICKETMASTER_ARTIST_MIN_SITELINKS=20
